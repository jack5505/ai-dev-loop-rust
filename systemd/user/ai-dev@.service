[Unit]
Description=AI dev loop (%i) — одна итерация разработки

[Service]
Type=oneshot
# %i = имя инстанса: ai-dev@backend → ~/.config/ai-dev-backend.env
EnvironmentFile=%h/.config/ai-dev-%i.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=%h
ExecStart=%h/.local/bin/ai-dev run --instance %i
Nice=10
# C9: потолок обязан быть заметно больше APP_WAIT_MIN (по умолчанию 180 мин).
# Проверяется командой `ai-dev config check --instance %i`.
TimeoutStartSec=4h
